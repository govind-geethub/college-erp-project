# Copy this file to .env and replace each placeholder with a private value.
ENVIRONMENT=development
DEMO_AUTH_ENABLED=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DEMO_ADMIN_PASSWORD=replace-with-a-private-admin-password
DEMO_FACULTY_PASSWORD=replace-with-a-private-faculty-password
DEMO_MODERATOR_PASSWORD=replace-with-a-private-moderator-password
